{
    "name": "school-saas-backend",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "tsx watch --import ./src/instrument.ts src/index.ts",
        "build": "tsc -p tsconfig.json",
        "start": "node --import ./dist/instrument.js dist/index.js",
        "test": "tsx --test tests/**/*.test.ts",
        "test:watch": "tsx --watch --test tests/**/*.test.ts",
        "db:generate": "prisma generate",
        "db:migrate": "prisma migrate dev --skip-generate && npm run db:generate",
        "db:push": "prisma db push",
        "db:seed": "tsx prisma/seed.ts",
        "db:studio": "prisma studio"
    },
    "dependencies": {
        "@prisma/client": "^5.22.0",
        "@sentry/node": "^10.39.0",
        "@sentry/profiling-node": "^10.39.0",
        "bcryptjs": "^3.0.3",
        "cors": "^2.8.5",
        "dotenv": "^17.2.3",
        "express": "^5.1.0",
        "jsonwebtoken": "^9.0.3",
        "prisma": "^5.22.0",
        "redis": "^5.12.1",
        "zod": "^4.3.6"
    },
    "devDependencies": {
        "@types/cors": "^2.8.19",
        "@types/express": "^5.0.3",
        "@types/jsonwebtoken": "^9.0.10",
        "@types/node": "^24.10.1",
        "@types/supertest": "^7.2.0",
        "supertest": "^7.2.2",
        "tsx": "^4.20.6",
        "typescript": "^5.9.3"
    }
}